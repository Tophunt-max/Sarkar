<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SarkariExamUpdates" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary</item>
        <item name="colorAccent">@color/two</item>
        <item name="android:windowBackground">@color/back</item>
        <item name="android:statusBarColor">@color/primary</item>
    </style>

    <style name="Theme.Fullscreen" parent="Theme.SarkariExamUpdates">
        <item name="android:windowBackground">@color/primary</item>
    </style>

    <style name="Toolbar" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@color/primary</item>
    </style>

    <style name="ToolbarTitle" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CardTitle" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Meta" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/txtlight</item>
    </style>
</resources>
