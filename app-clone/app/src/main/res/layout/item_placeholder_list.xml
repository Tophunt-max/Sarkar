<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from the original app's res/layout/item_placeholder_list.xml (decoded with Apktool). -->
<RelativeLayout android:padding="@dimen/_16sdp" android:layout_width="match_parent" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android">
