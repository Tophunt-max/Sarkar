<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from the original app's res/layout/activity_allgovjob_content.xml (decoded with Apktool). -->
<RelativeLayout android:background="@color/back" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@+id/actionbar"
        android:background="@color/primary"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/gs_ashoka_chakra"
            android:layout_marginStart="@dimen/_minus6sdp" />
        <ImageView
            android:id="@+id/backbutton"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:src="@drawable/gs_back"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/_5sdp" />
        <TextView
            android:textSize="@dimen/_13sdp"
            android:textColor="@color/white"
            android:id="@+id/titlebar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Job Details"
            android:layout_centerVertical="true"
            android:fontFamily="@font/poppins_semibold"
            android:paddingStart="@dimen/_5sdp"
            android:layout_toEndOf="@id/backbutton" />
        <ImageView
            android:id="@+id/shareBtn"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/_10sdp"
            android:contentDescription="@string/share_app"
            android:foreground="?selectableItemBackground"
            android:src="@drawable/gs_share"
            app:tint="@color/white" />
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/adMobView"
        android:layout_below="@id/actionbar">
        <androidx.cardview.widget.CardView
            android:id="@+id/qualification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_5sdp"
            android:foreground="?selectableItemBackground"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/_5sdp"
            app:cardElevation="@dimen/_2sdp">
            <RelativeLayout
                android:id="@+id/nextbtn"
                android:padding="@dimen/_5sdp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="15.0sp"
                    android:textColor="@color/black"
                    android:id="@+id/heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:layout_toLeftOf="@id/alarm"
                    android:fontFamily="@font/poppins_medium" />
                <ImageView
                    android:id="@+id/alarm"
                    android:visibility="gone"
                    android:layout_width="@dimen/_12sdp"
                    android:layout_height="@dimen/_12sdp"
                    android:layout_marginTop="5.0dp"
                    android:layout_marginBottom="5.0dp"
                    android:src="@drawable/gs_reminder"
                    android:layout_alignParentRight="true"
                    android:layout_marginStart="5.0dp"
                    android:layout_marginEnd="5.0dp" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/dateinfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="5.0"
                    android:layout_below="@id/heading">
                    <TextView
                        android:textSize="10.0sp"
                        android:textColor="@color/txtlight"
                        android:id="@+id/time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:layout_weight="3.0"
                        android:fontFamily="@font/poppins_extralight" />
                    <TextView
                        android:textSize="10.0sp"
                        android:textColor="@color/txtlight"
                        android:id="@+id/lastdate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:fontFamily="@font/poppins_extralight" />
                </LinearLayout>
                <WebView
                    android:textSize="13.0sp"
                    android:textColor="@color/black"
                    android:id="@+id/descrption"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text=" "
                    android:layout_below="@id/dateinfo" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/shimmer_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/actionbar"
        app:duration="1000">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/item_placeholder_list" />
            <include layout="@layout/item_placeholder_list" />
            <include layout="@layout/item_placeholder_list" />
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <RelativeLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/adMobView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />
</RelativeLayout>
