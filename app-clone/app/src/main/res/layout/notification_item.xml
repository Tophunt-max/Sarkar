<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from the original app's res/layout/notification_item.xml (decoded with Apktool). -->
<RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.cardview.widget.CardView
            android:id="@+id/qualification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_5sdp"
            android:foreground="?selectableItemBackground"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/_5sdp"
            app:cardElevation="@dimen/_2sdp">
            <RelativeLayout
                android:id="@+id/nextbtn"
                android:padding="@dimen/_5sdp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="15.0sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-1.0dp"
                    android:text=""
                    android:fontFamily="@font/poppins_regular" />
                <TextView
                    android:textSize="13.0sp"
                    android:id="@+id/descrption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-1.0dp"
                    android:text=""
                    android:layout_below="@id/title"
                    android:fontFamily="@font/poppins_regular" />
                <TextView
                    android:textSize="13.0sp"
                    android:textColor="@color/txtlight"
                    android:gravity="right"
                    android:id="@+id/time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:text="1 hours ago"
                    android:layout_below="@id/descrption"
                    android:fontFamily="@font/poppins_regular" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</RelativeLayout>
