<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from the original app's res/layout/activity_splash_screen.xml (decoded with Apktool). -->
<RelativeLayout android:gravity="center" android:orientation="horizontal" android:background="@color/primary" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:background="@drawable/ic_splash"
            android:layout_width="180.0dp"
            android:layout_height="180.0dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:layout_centerInParent="true" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_20sdp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="@dimen/_15sdp"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:fontFamily="@font/poppins_medium" />
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/mainadsgone"
        android:background="#cc000000"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</RelativeLayout>
