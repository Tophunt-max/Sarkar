<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from the original app's res/layout/activity_all_govjob.xml (decoded with Apktool). -->
<RelativeLayout android:background="@color/back" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@+id/actionbar"
        android:background="@color/primary"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/gs_ashoka_chakra"
            android:layout_marginStart="@dimen/_minus6sdp" />
        <ImageView
            android:id="@+id/backbutton"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:src="@drawable/gs_back"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/_5sdp" />
        <TextView
            android:textSize="@dimen/_13sdp"
            android:textColor="@color/white"
            android:id="@+id/titlebar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gov. Jobs"
            android:layout_centerVertical="true"
            android:fontFamily="@font/poppins_semibold"
            android:paddingStart="@dimen/_5sdp"
            android:layout_toEndOf="@id/backbutton" />
        <TextView
            android:textSize="@dimen/_10sdp"
            android:textColor="@color/white"
            android:id="@+id/viewexpired"
            android:background="@drawable/gs_roundtext"
            android:padding="@dimen/_5sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/_5sdp"
            android:text="View Expired"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:fontFamily="@font/poppins_semibold"
            android:paddingStart="@dimen/_5sdp" />
    </RelativeLayout>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/shimmer_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/actionbar"
        app:duration="1000">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/item_placeholder_list" />
            <include layout="@layout/item_placeholder_list" />
            <include layout="@layout/item_placeholder_list" />
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/adMobView"
        android:layout_below="@id/actionbar">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyc_ipo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginRight="@dimen/_10sdp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <TextView
        android:textSize="20.0sp"
        android:textColor="@color/black"
        android:id="@+id/txt_noData"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No data Found"
        android:layout_centerInParent="true"
        android:fontFamily="@font/poppins_medium" />
    <RelativeLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/adMobView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />
</RelativeLayout>
