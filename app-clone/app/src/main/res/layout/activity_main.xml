                                android:layout_height="match_parent"
                                android:layout_marginTop="@dimen/_5sdp"
                                android:text="Current Affairs"
                                android:fontFamily="@font/poppins_medium" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
            <LinearLayout
